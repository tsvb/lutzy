# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Swift Package Manager
.build/
.swiftpm/
# No Package.resolved: LUTzy has zero third-party dependencies by design.

# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
**/xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Build products
build/
*.o
*.swiftmodule

# Claude Code
.claude/

# Local real-world test assets (large RAW/JPG fixtures, not for version control)
realworldtest/

# Local curated LUT binaries. Source/license review and a Git LFS policy must
# be completed before publishing these large third-party assets. The manifest,
# audit, and curator remain tracked so this local corpus is reproducible.
/LUTLibrary/LUTs/**/*.cube
/LUTLibrary/Unsupported/**/*.cube
